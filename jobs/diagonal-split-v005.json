{
  "id": "diagonal-split-v005",
  "output": "outputs/jobs/diagonal-split-v005",
  "asset_type": "packaging",
  "model": "Diagonal Split: 100 mm cube, top 25 mm cut corner to corner into two triangular lid trays that swing up on brass butt hinges on the two back top edges, base shell with a white inner tray",
  "baseline": "diagonal-split-v004 geometry with the exact Select look: materials (Select | exterior, Select | interior), the four PCS2 lights and light-path settings copied verbatim from Final Blender/Perhaps_Select_Box.blend.",
  "input": "assets/watches/baseline/empty_base.blend",
  "references": [
    "config/presets/box_diagonal_split.json",
    "config/presets/box_diagonal_split_look.json",
    "Final Blender/Perhaps_Select_Box.blend"
  ],
  "stages": [
    {
      "name": "build",
      "step": "box_diagonal_split",
      "params": {
        "spec": "config/presets/box_diagonal_split.json"
      }
    },
    {
      "name": "logo",
      "step": "box_logo_stamp",
      "params": {
        "object": "Box | Lid A",
        "svg": "references/brand/perhaps-wordmark-v2.clean.svg",
        "width_mm": 48.0,
        "center_z_mm": 87.5,
        "front_y_mm": -50.0,
        "depth_mm": 0.32,
        "shoulder_mm": 0.45,
        "shoulder_round": 0.3,
        "coarse_mm": 0.4,
        "fine_div": 4,
        "uv": "Metric UV"
      }
    },
    {
      "name": "export",
      "step": "glb_bake_look",
      "params": {
        "source": "Final Blender/Perhaps_Select_Box.blend",
        "materials": {
          "Diagonal Split | exterior": "Select | exterior",
          "Diagonal Split | accent": "Select | interior",
          "Diagonal Split | exterior | stamped": "Select | exterior"
        },
        "tile_mm": 200,
        "px": 1024,
        "uv": "Metric UV",
        "glb": "outputs/jobs/diagonal-split-v005/diagonal-split.glb"
      }
    },
    {
      "name": "look",
      "step": "packaging_tier",
      "params": {
        "preset": "config/presets/box_diagonal_split_look.json"
      }
    },
    {
      "name": "float",
      "step": "floating_stage",
      "params": {
        "camera_preset": "config/presets/floating_hero_low_angle_arc_reveal.json",
        "studio_preset": "config/presets/dramatic_luxury_floating_studio.A2.json",
        "tier": {}
      }
    },
    {
      "name": "stage",
      "step": "cinematic_studio",
      "params": {
        "studio_preset": "config/presets/perhaps_cinematic_studio_v2.json",
        "tier": {}
      }
    },
    {
      "name": "select-look",
      "step": "copy_look",
      "params": {
        "source": "Final Blender/Perhaps_Select_Box.blend",
        "materials": {
          "Diagonal-Split | exterior": "Select | exterior",
          "Diagonal-Split | accent": "Select | interior",
          "Diagonal Split | exterior | stamped": "Select | exterior | stamped"
        },
        "lights_prefix": "PCS2 |"
      }
    },
    {
      "name": "preview",
      "render": {
        "camera": "CAM | floating_hero_low_angle",
        "resolution": 2048,
        "profile": "preview",
        "border": [
          0,
          1,
          0.1667,
          0.8333
        ],
        "camera_override": {
          "position": [
            -0.656,
            -0.334,
            0.475
          ],
          "target": [
            0,
            0,
            0.05
          ],
          "lens_mm": 90
        }
      }
    },
    {
      "name": "open",
      "step": "scene_frame",
      "params": {
        "frame": 30
      }
    },
    {
      "name": "preview-open",
      "render": {
        "camera": "CAM | floating_hero_low_angle",
        "resolution": 2048,
        "profile": "preview",
        "border": [
          0,
          1,
          0.1667,
          0.8333
        ],
        "camera_override": {
          "position": [
            -0.905,
            -0.461,
            0.625
          ],
          "target": [
            0,
            0,
            0.085
          ],
          "lens_mm": 90
        }
      }
    }
  ]
}
