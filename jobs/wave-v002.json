{
  "id": "wave-v002",
  "output": "outputs/jobs/wave-v002",
  "asset_type": "packaging",
  "model": "09 Wave: 100 mm cube, lift-off lid with a wave seam, cream inner collar showing in the wave reveal",
  "baseline": "v001 with the seam taken from the sketch: measured height profile along each face (level at the side corners, ~15 mm crest just before mid-face, small dip near 80 %, ~9 mm at the front / back corner), 6 mm reveal, collar 10 mm above the base, 1 mm rounded edges. Select look (materials, PCS2 lights, light paths) copied from Final Blender/Perhaps_Select_Box.blend, perhaps wordmark debossed on the lid front, GLB with baked Select textures.",
  "input": "assets/watches/baseline/empty_base.blend",
  "references": [
    "references/packaging/09_wave.png",
    "config/presets/box_wave.json",
    "Final Blender/Perhaps_Select_Box.blend"
  ],
  "stages": [
    {
      "name": "build",
      "step": "box_wave",
      "params": {
        "spec": "config/presets/box_wave.json"
      }
    },
    {
      "name": "logo",
      "step": "box_logo_stamp",
      "params": {
        "object": "Box | Lid",
        "svg": "references/brand/perhaps-wordmark-v2.clean.svg",
        "width_mm": 54.0,
        "center_z_mm": 78.0,
        "front_y_mm": -50.0,
        "depth_mm": 0.32,
        "shoulder_mm": 0.45,
        "shoulder_round": 0.3,
        "coarse_mm": 0.4,
        "fine_div": 4,
        "uv": "Metric UV"
      }
    },
    {
      "name": "export",
      "step": "glb_bake_look",
      "params": {
        "source": "Final Blender/Perhaps_Select_Box.blend",
        "materials": {
          "Wave | exterior": "Select | exterior",
          "Wave | accent": "Select | interior",
          "Wave | exterior | stamped": "Select | exterior"
        },
        "tile_mm": 200,
        "px": 1024,
        "uv": "Metric UV",
        "glb": "outputs/jobs/wave-v002/wave.glb"
      }
    },
    {
      "name": "float",
      "step": "floating_stage",
      "params": {
        "camera_preset": "config/presets/floating_hero_low_angle_arc_reveal.json",
        "studio_preset": "config/presets/dramatic_luxury_floating_studio.A2.json",
        "tier": {}
      }
    },
    {
      "name": "stage",
      "step": "cinematic_studio",
      "params": {
        "studio_preset": "config/presets/perhaps_cinematic_studio_v2.json",
        "tier": {}
      }
    },
    {
      "name": "select-look",
      "step": "copy_look",
      "params": {
        "source": "Final Blender/Perhaps_Select_Box.blend",
        "materials": {
          "Wave | exterior": "Select | exterior",
          "Wave | accent": "Select | interior",
          "Wave | exterior | stamped": "Select | exterior | stamped"
        },
        "lights_prefix": "PCS2 |"
      }
    },
    {
      "name": "preview",
      "render": {
        "camera": "CAM | floating_hero_low_angle",
        "resolution": 2048,
        "profile": "preview",
        "border": [
          0,
          1,
          0.1667,
          0.8333
        ],
        "camera_override": {
          "position": [
            -0.656,
            -0.334,
            0.475
          ],
          "target": [
            0,
            0,
            0.05
          ],
          "lens_mm": 90
        }
      }
    },
    {
      "name": "open",
      "step": "box_lift",
      "params": {
        "lift_mm": 75
      }
    },
    {
      "name": "preview-open",
      "render": {
        "camera": "CAM | floating_hero_low_angle",
        "resolution": 2048,
        "profile": "preview",
        "border": [
          0,
          1,
          0.1667,
          0.8333
        ],
        "camera_override": {
          "position": [
            -0.37,
            -0.92,
            0.58
          ],
          "target": [
            0,
            0,
            0.088
          ],
          "lens_mm": 90
        }
      }
    }
  ]
}
