{
  "id": "seiko-snk607k1-v003-presentation",
  "output": "outputs/jobs/seiko-snk607k1-v003-presentation",
  "asset_type": "watch",
  "model": "Seiko 5 Automatic SNK607K1",
  "baseline": "Presentation previews of the v003 build in the dark kit (Phase 4); preview quality until the designer approves",
  "input": "assets/watches/baseline/empty_base.blend",
  "references": [
    "references/seiko-snk607k1/REFERENCE_PLAN.md",
    "config/watches/seiko-snk607k1-v1.json",
    "config/presets/watch_kit_front_seiko.json"
  ],
  "stages": [
    {
      "name": "build",
      "step": "watch_seiko_front",
      "params": {
        "spec": "config/watches/seiko-snk607k1-v1.json"
      }
    },
    {
      "name": "kit",
      "step": "watch_kit",
      "params": {
        "kit_preset": "config/presets/watch_kit_front_seiko.json",
        "pose": "SKO | pose"
      }
    },
    {
      "name": "preview-front-ref",
      "render": {
        "camera": "CAM | front_ref",
        "resolution": 2048,
        "profile": "preview",
        "aspect_h_over_w": 1.25
      }
    },
    {
      "name": "preview-front-macro",
      "render": {
        "camera": "CAM | front_ref_macro",
        "resolution": 2048,
        "profile": "preview",
        "aspect_h_over_w": 1.25
      }
    },
    {
      "name": "preview-crown-side-3q",
      "render": {
        "camera": "CAM | crown_side_3q",
        "resolution": 2048,
        "profile": "preview",
        "aspect_h_over_w": 1.25
      }
    }
  ]
}
