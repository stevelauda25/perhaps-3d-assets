            "power_w": 0.1
          },
          "PCS2 | 04 Underside bounce": {
            "power_w": 0.05
          }
        }
      }
    },
    {
      "name": "closed",
      "render": {
        "camera": "CAM | floating_hero_low_angle",
        "resolution": 2048,
        "profile": "preview",
        "border": [
