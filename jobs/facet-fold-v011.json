{
  "id": "facet-fold-v011",
  "output": "outputs/jobs/facet-fold-v011",
  "asset_type": "packaging",
  "model": "12 Facet Fold v010: 140 mm cube, magnetic L flap cover on the back hinge, oxblood grained leather outside, small raised champagne-gold Perhaps and star, cream suede lining, card and fitted cushion",
  "baseline": "v010 darker and richer: exterior tinted from oxblood to deep maroon (low sheen), interior a warmer deeper ivory, front fill removed; key and upper edge strip carry the light. Geometry and views as v010.",
  "input": "assets/watches/baseline/empty_base.blend",
  "references": [
    "textures/sources/designer_oxblood_leather/source_photo.png",
    "references/packaging/12_facet_fold_proportions.png",
    "references/packaging/11_facet_star_v003.png",
    "config/presets/box_facet_fold_v010.json",
