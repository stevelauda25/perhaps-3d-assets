{
  "id": "arc-reveal-v001",
  "output": "outputs/jobs/arc-reveal-v001",
  "asset_type": "packaging",
  "model": "07 Arc Reveal: 100 mm cube, lift-off lid with arch cuts, base with flush arch panels, insert, cushion",
  "baseline": "First build. New geometry (not the canonical tier box, so no geometry_lock). GLB carries plain colours; renders use library paper006 via packaging_tier, tier floating pose + PERHAPS_CINEMATIC_STUDIO_V2 rig.",
  "input": "assets/watches/baseline/empty_base.blend",
  "references": [
    "references/packaging/07_arc_reveal.png",
    "config/presets/box_arc_reveal.json",
    "config/presets/box_arc_reveal_look.json"
  ],
  "stages": [
    {
      "name": "build",
      "step": "box_arc_reveal",
      "params": {
        "spec": "config/presets/box_arc_reveal.json"
      }
    },
    {
      "name": "export",
      "step": "watch_export_glb",
      "params": {
        "glb": "outputs/jobs/arc-reveal-v001/arc-reveal.glb"
      }
    },
    {
      "name": "look",
      "step": "packaging_tier",
      "params": {
        "preset": "config/presets/box_arc_reveal_look.json"
      }
    },
    {
      "name": "float",
      "step": "floating_stage",
      "params": {
        "camera_preset": "config/presets/floating_hero_low_angle_arc_reveal.json",
        "studio_preset": "config/presets/dramatic_luxury_floating_studio.A2.json",
        "tier": {}
      }
    },
    {
      "name": "stage",
      "step": "cinematic_studio",
      "params": {
        "studio_preset": "config/presets/perhaps_cinematic_studio_v2.json",
        "tier": {}
      }
    },
    {
      "name": "preview",
      "render": {
        "camera": "CAM | floating_hero_low_angle",
        "resolution": 2048,
        "profile": "preview",
        "border": [
          0,
          1,
          0.1667,
          0.8333
        ]
      }
    },
    {
      "name": "open",
      "step": "box_lift",
      "params": {
        "lift_mm": 75
      }
    },
    {
      "name": "preview-open",
      "render": {
        "camera": "CAM | floating_hero_low_angle",
        "resolution": 2048,
        "profile": "preview",
        "border": [
          0,
          1,
          0.1667,
          0.8333
        ],
        "camera_override": {
          "position": [
            -0.37,
            -0.92,
            0.58
          ],
          "target": [
            0,
            0,
            0.088
          ],
          "lens_mm": 90
        }
      }
    }
  ]
}